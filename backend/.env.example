# Copy to .env and fill in for anything beyond a local demo. Nothing here is
# hardcoded in code — see app/config.py for the full list of settings and
# their defaults.

# JWT_SECRET=replace-with-a-real-random-secret
# DEMO_MODE=false

# Official Gujarat Police camera catalogue (Phase 3). Left empty until the
# real sandbox host is provided at the event — sync fails with a clear error
# while empty rather than guessing a host.
# CAMERA_CATALOG_BASE_URL=https://<official-sandbox-host>

# Real Sentinel Camera Grid (final integration task). Base URL/RTSP host/port
# already default correctly in app/config.py — only the credentials below are
# genuinely secret and must be set here (never in source, never pasted into
# chat/commit messages). Log in at https://cctv.corp8.cloud/auth/login once
# with these to confirm they're correct before relying on them here.
# SENTINEL_GRID_EMAIL=you@example.com
# SENTINEL_GRID_PASSWORD=replace-with-the-real-password

# --- V2 ---------------------------------------------------------------------

# Datastore. Unset means SQLite at DB_PATH — the local development default,
# unchanged. Production sets a PostgreSQL URL, where Alembic owns the schema
# (`alembic upgrade head`), not the additive helpers in app/db.py.
# DATABASE_URL=postgresql+psycopg://sentinel:password@localhost:5432/sentinel

# Prometheus scrape token for /api/metrics. Empty means only an Administrator
# JWT is accepted. There is no unauthenticated mode.
# METRICS_TOKEN=

# Dedicated license-plate detection weights. NOT bundled: this repo ships only
# yolov8n.pt (COCO), which has no plate class. Empty, or a path that does not
# exist, falls back to the classical localizer — which needs no asset and is
# the documented default path, not a failure.
# PLATE_MODEL_NAME=license-plate.pt

# Set false to restore the exact pre-V2 ANPR behavior (whole vehicle crop to
# OCR, one Plate row per passing frame). A real escape hatch, not decoration:
# the V2 path changes both OCR cost and sighting-row cardinality.
# PLATE_PIPELINE_V2=true
