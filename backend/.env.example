# Copy to .env and fill in for anything beyond a local demo. Nothing here is
# hardcoded in code — see app/config.py for the full list of settings and
# their defaults.

# JWT_SECRET=replace-with-a-real-random-secret
# DEMO_MODE=false

# Official Gujarat Police camera catalogue (Phase 3). Left empty until the
# real sandbox host is provided at the event — sync fails with a clear error
# while empty rather than guessing a host.
# CAMERA_CATALOG_BASE_URL=https://<official-sandbox-host>

# Real Sentinel Camera Grid (final integration task). Base URL/RTSP host/port
# already default correctly in app/config.py — only the credentials below are
# genuinely secret and must be set here (never in source, never pasted into
# chat/commit messages). Log in at https://cctv.corp8.cloud/auth/login once
# with these to confirm they're correct before relying on them here.
# SENTINEL_GRID_EMAIL=you@example.com
# SENTINEL_GRID_PASSWORD=replace-with-the-real-password

# --- V2 ---------------------------------------------------------------------

# Datastore. Unset means SQLite at DB_PATH — the local development default,
# unchanged. Production sets a PostgreSQL URL, where Alembic owns the schema
# (`alembic upgrade head`), not the additive helpers in app/db.py.
# DATABASE_URL=postgresql+psycopg://sentinel:password@localhost:5432/sentinel

# Prometheus scrape token for /api/metrics. Empty means only an Administrator
# JWT is accepted. There is no unauthenticated mode.
# METRICS_TOKEN=

# Dedicated license-plate detection weights. NOT bundled: this repo ships only
# yolov8n.pt (COCO), which has no plate class. Empty, or a path that does not
# exist, falls back to the classical localizer — which needs no asset and is
# the documented default path, not a failure.
# PLATE_MODEL_NAME=license-plate.pt

# Set false to restore the exact pre-V2 ANPR behavior (whole vehicle crop to
# OCR, one Plate row per passing frame). A real escape hatch, not decoration:
# the V2 path changes both OCR cost and sighting-row cardinality.
# PLATE_PIPELINE_V2=true

# Preprocessing variants read per plate, comma-separated. EACH ONE COSTS A FULL
# EXTRA OCR PASS — the most expensive operation in the camera loop — so the
# default is the single variant that reproduces the long-standing behavior.
# Valid: original, gray, clahe, denoise, sharpen, adaptive, otsu.
#
# "original,sharpen,adaptive" is the measured recovery set: on the 25-plate
# labelled corpus it improved character error rate (0.3896 -> 0.3030) at 3x the
# OCR cost, while exact match moved by a single sample — inside that corpus's
# noise band, so it is NOT an accuracy improvement. Opt in deliberately.
# PLATE_PREPROCESS_VARIANTS=clahe

# How many preprocessing variants must agree before a multi-variant read counts
# as corroborated. Only consulted when more than one variant is enabled, and it
# can only ever make the quality gate STRICTER — selecting among several reads
# shifts confidence upward, and this stops that drift from loosening the gate.
# PLATE_MIN_VARIANTS_AGREEING=2

# How many OCR observations across frames must agree on the same plate before it
# becomes a TRUSTED sighting. 1 restores the previous behavior (persist on the
# first passing read). Uncorroborated reads are still recorded — flagged
# pending_review rather than discarded — so a fast-moving vehicle is not lost.
# PLATE_MIN_OBSERVATIONS=2

# true = do not persist uncorroborated reads at all. Off by default: silently
# discarding real observations is the worse failure for an investigative system.
# PLATE_REQUIRE_CONSENSUS=false

# Save the plate region OCR actually read next to the full-frame evidence
# snapshot, so a reviewer can see what the read was based on. One extra small
# image per NEW sighting (not per frame).
# PLATE_DEBUG_CROPS=false

# A watchlist match reaches CRITICAL only if the plate read was ALSO corroborated
# across frames, not merely confident. Measured: OCR confidence does not separate
# correct reads from wrong ones (correct 0.262-0.990, wrong 0.260-0.956; six of
# seven wrong reads sit above the lowest correct one), so a confident single
# frame is not evidence. An uncorroborated match still fires at HIGH, labelled
# UNCORROBORATED — nothing is silenced, only the auto-escalation. Set false to
# restore confidence-only escalation.
# WATCHLIST_REQUIRE_CORROBORATION=true

# Distributed runtime state (app/runtime_state.py): the alert cooldown, the
# self-heal duplicate window and the login rate limiter. Empty (the default,
# and what a local `uvicorn` run has always done) keeps them in-process,
# correct for exactly this one process. Point it at a real Redis to share
# them across more than one backend process — see docker-compose.yml for the
# deployment that actually wires one up.
# REDIS_URL=redis://localhost:6379/0
