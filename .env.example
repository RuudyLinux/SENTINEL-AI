# SENTINEL VISION — docker compose environment.
#
#   cp .env.example .env    then fill in the required values below.
#
# This file is a template and is committed. `.env` is gitignored and is the only
# place real secrets belong — never in source, docs, or a compose file.
# For local (non-Docker) development see backend/.env.example instead.

# --- Required ---------------------------------------------------------------

# PostgreSQL password. Compose refuses to start without it rather than running
# a police datastore on a default credential.
POSTGRES_PASSWORD=

# JWT signing secret. With DEMO_MODE=false the backend refuses to start on the
# bundled dev default or anything under 32 characters (see app/config.py).
# Generate one:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=

# --- Optional ---------------------------------------------------------------

POSTGRES_USER=sentinel
POSTGRES_DB=sentinel

# false (the compose default) is production mode: no seeded demo accounts, and
# the JWT secret above is enforced. Set true only to demo the documented
# admin/sentinel123 flow.
DEMO_MODE=false

BACKEND_PORT=8000
FRONTEND_PORT=3000

# Must match the origin the dashboard is actually served from, or the browser
# blocks every API call.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Read by the frontend at BUILD time (Next inlines them), so changing these
# requires a rebuild, not just a restart.
NEXT_PUBLIC_API_BASE=http://localhost:8000
NEXT_PUBLIC_WS_BASE=ws://localhost:8000

# Optional brand mark. Empty (the default) renders the project's own shield
# icon, which always exists; set this only once a real logo file is in place,
# or every page load requests a file that is not there. See
# frontend/public/branding/README.md.
NEXT_PUBLIC_BRAND_LOGO_URL=

# Shared secret a Prometheus scraper presents as a bearer token on
# /api/metrics. Leave empty to allow only Administrator JWTs. There is no
# unauthenticated mode.
METRICS_TOKEN=

# Backs distributed runtime state (backend/app/runtime_state.py): the alert
# cooldown, the self-heal duplicate window and the login rate limiter, shared
# across every backend process rather than held separately by each. Genuinely
# optional — the backend probes it once at startup with a short timeout and
# falls back to in-process state (this compose file's behaviour before this
# setting existed) if it is absent or unreachable; it never blocks startup.
# The default below is the in-cluster service name and needs no changes for
# `docker compose up`.
REDIS_URL=redis://redis:6379/0

# --- Real camera integrations (optional) -------------------------------------
# Empty means "not configured": the app reports that clearly and never
# fabricates cameras. Credentials never reach the frontend.
SENTINEL_GRID_EMAIL=
SENTINEL_GRID_PASSWORD=
CAMERA_CATALOG_BASE_URL=
